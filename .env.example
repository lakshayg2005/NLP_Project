# Copy to .env and adjust.

# SQLite is used when DATABASE_URL is unset. For PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://auditor:auditor@localhost:5432/compliance

# Phase 2 backend: "setfit" (fine-tuned, CPU friendly) or "zero_shot" (bart-large-mnli)
CLASSIFIER_BACKEND=setfit
ZERO_SHOT_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SETFIT_MODEL_DIR=models/setfit
SPAN_MODEL_DIR=models/span_extractor

# Optional Hugging Face Hub repos used when local trained models are absent.
# SETFIT_MODEL_REPO=your-account/your-setfit-model
# SPAN_MODEL_REPO=your-account/your-span-model
# HF_SPACE=true limits the dashboard navigation to Live audit.

# Routing thresholds
FLAG_THRESHOLD=0.70
REVIEW_THRESHOLD=0.50
SEMANTIC_THRESHOLD=0.30
